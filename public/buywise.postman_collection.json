  "item": [
    {
      "name": "01 - System & Session",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Check service health and sandbox mode status."
          }
        },
        {
          "name": "Bootstrap Session & Workspace",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bootstrap",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bootstrap"]
            },
            "description": "Initializes or refreshes the protected HttpOnly/SameSite session, returning active mandate, spend headroom balance, 36 catalog products, and recent intents."
          }
        }
      ]
    },
    {
      "name": "02 - Mandate Policy & What-If Simulator",
      "item": [
        {
          "name": "Confirm or Update Spending Mandate",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Origin", "value": "{{baseUrl}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Q4 Office Refresh\",\n  \"budgetCents\": 30000,\n  \"maxPurchaseCents\": 30000,\n  \"durationHours\": 24,\n  \"maxQuantity\": 8,\n  \"category\": \"keyboards\",\n  \"categories\": [\"keyboards\", \"mice\"],\n  \"categoryLimits\": {\n    \"keyboards\": 5,\n    \"mice\": 3\n  },\n  \"merchantIds\": [\"buywise-merchant\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mandates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mandates"]
            },
            "description": "Saves a user-confirmed spending mandate governing budget, single-order cap, duration, and per-category limits."
          }
        },
        {
          "name": "Simulate Mandate Impact (\"What-If\" Simulator)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Origin", "value": "{{baseUrl}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Simulated Stricter Policy\",\n  \"budgetCents\": 15000,\n  \"maxPurchaseCents\": 5000,\n  \"durationHours\": 24,\n  \"maxQuantity\": 3,\n  \"category\": \"keyboards\",\n  \"categories\": [\"keyboards\"],\n  \"categoryLimits\": {},\n  \"merchantIds\": [\"buywise-merchant\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mandates/simulate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mandates", "simulate"]
            },
            "description": "Executes a zero-mutation dry-run of prospective mandate rules against historical purchases and catalog risk exposure."
          }
        },
        {
          "name": "Revoke Mandate",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Origin", "value": "{{baseUrl}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mandates/revoke",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mandates", "revoke"]
            },
            "description": "Immediately revokes the active mandate and cancels all unsubmitted reservations."
          }
        }
