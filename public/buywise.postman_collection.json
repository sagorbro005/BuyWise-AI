        {
          "name": "PayPal Webhook Postback Receiver",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "PAYPAL-AUTH-ALGO", "value": "SHA256withRSA" },
              { "key": "PAYPAL-CERT-URL", "value": "https://api.sandbox.paypal.com/v1/notifications/certs/CERT-360caa42-fca2bf59-6963c620" },
              { "key": "PAYPAL-TRANSMISSION-ID", "value": "sample-transmission-id-001" },
              { "key": "PAYPAL-TRANSMISSION-SIG", "value": "sample-signature-001" },
              { "key": "PAYPAL-TRANSMISSION-TIME", "value": "2026-11-12T12:00:00Z" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"WH-SAMPLE-EVENT-001\",\n  \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"resource_type\": \"capture\",\n  \"resource\": {\n    \"id\": \"CAP-SAMPLE-001\",\n    \"status\": \"COMPLETED\",\n    \"amount\": {\n      \"currency_code\": \"USD\",\n      \"value\": \"245.00\"\n    },\n    \"supplementary_data\": {\n      \"related_ids\": {\n        \"order_id\": \"ORDER-SAMPLE-001\"\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/paypal/webhooks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "paypal", "webhooks"]
            },
            "description": "Receives asynchronous payment events, verifies cryptographic signature headers, and updates the decision trail."
          }
        }
      ]
