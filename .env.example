# Copy this file to .env.local.
# Leave blank locally (localhost and 127.0.0.1 work). Set the exact HTTPS origin when hosting.
APP_URL=
# Enable only for a local ngrok demo that also permits loopback browser origins.
ALLOW_LOCAL_DEMO=false
DATABASE_PATH=./data/buywise.db
# Choose a model available in YOUR free-tier Google AI Studio account.
GEMINI_API_KEY=
GEMINI_MODEL=
# Only sandbox credentials. Live PayPal is intentionally unsupported.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
